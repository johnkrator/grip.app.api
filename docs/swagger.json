                },
                "password": {
                    "type": "string"
                }
            }
        },
        "request.UserRegistrationRequestDto": {
            "type": "object",
            "required": [
                "address",
                "dateOfBirth",
                "email",
                "firstName",
                "incomeRange",
                "lastName",
                "occupation",
                "password",
                "phoneNumber",
                "riskTolerance"
